# Research scratch (synthesized into research/)
.research_raw/

# Generated diagnostic figures (regenerable from scripts)
figures/

# Secrets / tokens — never commit (token lives at ~/.edl_token, outside the repo)
*.token
.edl_token
.netrc
secrets.*
.env

# OS / editor
.DS_Store
.streamlit/secrets.toml
*.log
data/processed/aoi_cache/
